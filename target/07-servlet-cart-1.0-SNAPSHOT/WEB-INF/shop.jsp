<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ru"><head><meta charset="UTF-8"><title>Каталог и корзина</title></head><body><h1>Каталог</h1><table><tr><th>Название</th><th>Цена</th><th>Остаток</th><th>Действие</th></tr><c:forEach var="p" items="${products}"><tr><td><c:out value="${p.name}"/></td><td>${p.price}</td><td>${p.stock}</td><td><c:choose><c:when test="${p.stock > 0}"><form method="post" action="${pageContext.request.contextPath}/shop"><input type="hidden" name="id" value="${p.id}"><button>В корзину</button></form></c:when><c:otherwise>Нет в наличии</c:otherwise></c:choose></td></tr></c:forEach></table><h2>Ваша корзина</h2><c:if test="${empty sessionScope.cart}"><p>Корзина пуста</p></c:if><ul><c:forEach var="entry" items="${sessionScope.cart}"><li><c:out value="${applicationScope.catalog[entry.key].name}"/> × ${entry.value}</li></c:forEach></ul></body></html>
