<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
    <listener>
        <listener-class>com.study.shop.config.CatalogListener</listener-class>
    </listener>
    <filter>
        <filter-name>utf8</filter-name>
        <filter-class>com.study.shop.filter.RequestFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>utf8</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <servlet>
        <servlet-name>shop</servlet-name>
        <servlet-class>com.study.shop.controller.MainServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>shop</servlet-name>
        <url-pattern>/shop</url-pattern>
    </servlet-mapping>
</web-app>